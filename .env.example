# Copy to .env for docker compose. Nothing here is a secret: the system has none.
# Variable meanings and defaults are defined in contracts/services.json.

# --- Local emulation (docker compose) ---------------------------------------
GOOGLE_CLOUD_PROJECT=museum-planner-local
# fixture = bundled raw API payloads, fully offline. live = call the museum APIs.
SOURCE_MODE=fixture
MAX_OBJECTS=1500
CACHE_TTL_SECONDS=600
PLANNER_PORT=8080

# --- Without Docker: file store (see README.md) -----------------------------
# STORE_BACKEND=file
# FILE_STORE_DIR=.local/store

# --- Deployment placeholders (deploy/gcp-deploy.sh, GitHub Actions) ---------
# Fill these in when a GCP project and GitHub repository exist.
# GCP_PROJECT_ID=
# GCP_REGION=us-central1
# GITHUB_REPO_URL=https://github.com/karthikvalluri85/museum-planner
# WORKLOAD_IDENTITY_PROVIDER=projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/github/providers/github
# DEPLOY_SERVICE_ACCOUNT=github-deployer@GCP_PROJECT_ID.iam.gserviceaccount.com
