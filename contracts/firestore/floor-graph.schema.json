{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://museum-planner.example/contracts/firestore/floor-graph.schema.json",
  "title": "FloorGraph",
  "description": "Firestore document floor_graphs/{museum_id}. Hand-built per museum from its published floor plan. Edges are undirected. A node covers one gallery or a run of adjacent galleries on one level with no steps between them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["museum_id", "version", "source", "verification", "entrance_node_id", "nodes", "edges"],
  "properties": {
    "museum_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" },
    "version": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1, "description": "The floor plan this was built from: title, URL, date read." },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "notes"],
      "properties": {
        "status": { "enum": ["unverified", "partially_verified", "verified"] },
        "notes": { "type": ["string", "null"] },
        "verified_on": { "type": ["string", "null"], "format": "date" }
      }
    },
    "entrance_node_id": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "floor", "wing", "galleries", "sensory", "has_seating", "near_restroom", "near_cafe"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["gallery", "hub", "entrance"] },
        "floor": { "type": "string", "minLength": 1, "maxLength": 4 },
        "wing": { "type": "string", "minLength": 1 },
        "galleries": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Gallery numbers as the museum's API writes them. Empty for hubs and entrances. A gallery number belongs to at most one node."
        },
        "sensory": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["loud", "bright", "crowded"] }
        },
        "has_seating": { "type": "boolean" },
        "near_restroom": { "type": "boolean" },
        "near_cafe": { "type": "boolean" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "walk_minutes", "step_free", "kind", "name"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "walk_minutes": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
        "step_free": { "type": "boolean" },
        "kind": { "enum": ["level", "ramp", "elevator", "stairs", "escalator"] },
        "name": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "required": ["step_free"], "properties": { "step_free": { "const": false } } },
          "then": { "properties": { "name": { "type": "string", "minLength": 3 } } }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "enum": ["stairs", "escalator"] } } },
          "then": { "properties": { "step_free": { "const": false } } }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "elevator" } } },
          "then": { "properties": { "name": { "type": "string", "minLength": 3 } } }
        }
      ]
    }
  }
}
